# Application
APP_NAME=akademik-management
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=akademik-management
DB_USER=root
DB_PASSWORD=Root123!
DB_CHARSET=utf8mb4

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=168h

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
